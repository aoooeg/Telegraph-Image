//@version=5
strategy("简单DCA策略", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// 策略参数
initial_drop = input.float(4.0, "首次开仓跌幅%", minval=1.0, maxval=20.0)
add_drop = input.float(2.0, "加仓跌幅%", minval=0.5, maxval=10.0) 
max_adds = input.int(8, "最大加仓次数", minval=1, maxval=20)
position_pct = input.float(10.0, "每次仓位%", minval=1.0, maxval=100.0)

// 状态变量
var bool traded_today = false
var int add_count = 0
var float open_price = na

// 检测新的一天
is_new_day = ta.change(time("1D"))

// 每天开始重置
if is_new_day
    if strategy.position_size > 0
        strategy.close_all("日结平仓")
    traded_today := false
    add_count := 0
    open_price := open

// 记录开盘价
if na(open_price)
    open_price := open

// 计算跌幅
drop_pct = (open_price - close) / open_price * 100

// 首次开仓：跌幅达到4%
if drop_pct >= initial_drop and not traded_today
    strategy.entry("开仓", strategy.long, qty=position_pct/100*strategy.equity/close)
    traded_today := true
    add_count := 1

// 加仓逻辑：每跌2%加仓一次
if traded_today and add_count < max_adds
    required_drop = initial_drop + (add_count * add_drop)
    if drop_pct >= required_drop
        strategy.entry("加仓" + str.tostring(add_count+1), strategy.long, qty=position_pct/100*strategy.equity/close)
        add_count := add_count + 1

// 显示当前状态
if traded_today
    var label info_label = na
    label.delete(info_label)
    
    info_text = "开盘价: " + str.tostring(open_price, "#.####") + 
                "\n当前价: " + str.tostring(close, "#.####") + 
                "\n跌幅: " + str.tostring(drop_pct, "#.##") + "%" +
                "\n已开仓: " + str.tostring(add_count) + "/" + str.tostring(max_adds) +
                "\n仓位大小: " + str.tostring(strategy.position_size)
    
    info_label := label.new(bar_index, high, info_text, color=color.blue, style=label.style_label_down, size=size.normal)

// 绘制开盘价线
plot(open_price, "开盘价", color=color.blue, linewidth=2)

// 绘制开仓线和加仓线
first_entry_price = open_price * (1 - initial_drop/100)
plot(first_entry_price, "首次开仓线", color=color.green, linewidth=1)

for i = 1 to max_adds-1
    add_price = open_price * (1 - (initial_drop + i*add_drop)/100)
    plot(add_price, "加仓线" + str.tostring(i+1), color=color.orange, linewidth=1)

// 买入信号
plotshape(strategy.position_size > strategy.position_size[1], "买入", location.belowbar, color.lime, shape.triangleup, size.small)

// 卖出信号  
plotshape(strategy.position_size < strategy.position_size[1] and strategy.position_size[1] > 0, "卖出", location.abovebar, color.red, shape.triangledown, size.small)

// 调试信息
plotchar(traded_today, "已交易", "T", location.top, color.yellow, size=size.tiny)
plotchar(add_count, "加仓次数", "C", location.top, color.purple, size=size.tiny)